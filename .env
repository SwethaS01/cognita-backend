PORT=5000
# Local MongoDB, or paste your MongoDB Atlas connection string here
MONGO_URI=mongodb://127.0.0.1:27017/cognita_nexus
JWT_SECRET=change_this_secret
CLIENT_URL=http://localhost:5173
# Optional: first admin account (created only if it doesn't exist yet)
ADMIN_EMAIL=admin@cognita.test
ADMIN_PASSWORD=Admin@12345
# Max upload size in MB for shared PDFs/PPTs/etc.
MAX_UPLOAD_MB=15
